# ---------------------------------------------------------------------------
# CyberSOC AI — configuration template
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENV=dev

# --- Vector store (ADR-0001) ----------------------------------------------
VECTOR_DB=chroma
CHROMA_PATH=data/indexes/chroma
CHROMA_COLLECTION=soc_kb

# --- Embeddings (ADR-0002) ------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Chunking / retrieval -------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# --- Knowledge graph (Neo4j) ----------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- SLM under evaluation -------------------------------------------------
SLM_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# --- LLMOps tracking ------------------------------------------------------
MLFLOW_TRACKING_URI=file:./mlruns
